# ==========================================
# Core AI & Analytics Settings
# ==========================================
GEMINI_API_KEY="your_gemini_api_key_here"
GA4_PROPERTY_ID="your_ga4_property_id"
FIREBASE_KEY_PATH="serviceAccountKey.json"
GEMINI_MODEL="gemini-2.5-flash"

# ==========================================
# App Store Connect Income (Sales & Trends)
# Users and Access > Integrations > Team Keys: create a key with the Finance role.
# ASC_VENDOR_NUMBER is under Payments and Financial Reports.
# ==========================================
ASC_ISSUER_ID=""
ASC_KEY_ID=""
ASC_PRIVATE_KEY_PATH="AuthKey_XXXXXXXXXX.p8"
ASC_VENDOR_NUMBER=""

# ==========================================
# Optional: Notification Destinations
# (Fill only the channels you want to use)
# ==========================================

# 1. Telegram Bot (Instant iPhone & Desktop push)
# Create a bot via @BotFather on Telegram to get Token, get your Chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# 2. Discord Channel Webhook
# Server Settings > Integrations > Webhooks > Copy Webhook URL
DISCORD_WEBHOOK_URL=""

# 3. Gmail Notification (Sends to your email inbox & iPhone Mail)
# SENDER_EMAIL: Your Gmail address
# GMAIL_APP_PASSWORD: 16-char App Password (myaccount.google.com/apppasswords)
# RECIPIENT_EMAIL: The email where you want to receive reports
GMAIL_SENDER_EMAIL=""
GMAIL_APP_PASSWORD=""
GMAIL_RECIPIENT_EMAIL=""
